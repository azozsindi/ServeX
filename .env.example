# GEMINI_API_KEY: Required for Gemini AI Live API calls.
# On Vercel: Add this in Vercel Project Settings > Environment Variables.
# In AI Studio: Automatically injected from Settings > Secrets panel.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted (e.g. https://your-project.vercel.app).
APP_URL="https://your-project.vercel.app"

